# CampusVoice Production Environment Template (Railway)
# Copy this file to .env locally, or set these in Railway Project Settings > Variables.
# NEVER commit the real .env file with secrets to git!

# 1. Cryptographic Secret Keys
# Generate a strong 32-byte key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
WTF_CSRF_SECRET_KEY=replace-with-a-secure-random-csrf-key-in-production

# 2. Persistence & Storage (Railway Persistent Volume mounted at /data)
SQLITE_PATH=/data/campusvoice.db
UPLOAD_FOLDER=/data/uploads
MAX_IMAGE_FILE_SIZE=5242880

# 3. Public Service URL (Used in verification emails)
PUBLIC_BASE_URL=https://your-app-name.up.railway.app

# 4. Institutional Validation
COLLEGE_EMAIL_DOMAINS=campus.edu,university.ac.in,student.college.edu

# 5. HTTPS Security (Enables Secure session cookies and HSTS)
SESSION_COOKIE_SECURE=true

# 6. SMTP Email Provider (Production transactional SMTP)
# Note: Mailpit is for local development only and cannot send external mail.
# Configure a real SMTP provider (e.g., SendGrid, Mailgun, Amazon SES, Brevo):
SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_USE_TLS=true
SMTP_DEFAULT_SENDER=CampusVoice Portal <noreply@campus.edu>

# 7. Rate Limiting (Requests per minute per client IP)
AUTH_RATE_LIMIT=10
SUBMISSION_RATE_LIMIT=15

# 8. Web Server
HOST=0.0.0.0
PORT=5000
