# CampusVoice Environment Configuration
# Copy this file to .env and fill in production secrets.
# NEVER commit the real .env file with secrets to git!

# Cryptographic Secret Key (Used for sessions & CSRF signing)
# Generate a strong 32-byte key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
WTF_CSRF_SECRET_KEY=replace-with-a-secure-random-csrf-key

# Database Connection (Defaults to local SQLite database)
DATABASE_URL=sqlite:///campusvoice.db

# Allowed College Email Domains (Comma-separated exact domains)
COLLEGE_EMAIL_DOMAINS=campus.edu,university.ac.in,student.college.edu

# Cookie Security (Set to true in production over HTTPS)
SESSION_COOKIE_SECURE=false

# SMTP Server Settings (For email verification)
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_DEFAULT_SENDER=CampusVoice Portal <noreply@campus.edu>

# Rate Limiting (Requests per minute)
AUTH_RATE_LIMIT=10
SUBMISSION_RATE_LIMIT=15

# Upload Security
UPLOAD_FOLDER=uploads
MAX_IMAGE_FILE_SIZE=5242880
